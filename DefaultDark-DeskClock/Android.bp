runtime_resource_overlay {

    theme: "DefaultDark-DeskClock",
    product_specific: true,
    certificate: "platform",
    sdk_version: "current",
    resource_dirs: ["res"],
    name: "DefaultDark-DeskClock",
    // ANDROIDMK TRANSLATION ERROR: unsupported assignment to LOCAL_RESOURCE_DEPENDENCIES
    // LOCAL_RESOURCE_DEPENDENCIES := $(TARGET_OUT_INTERMEDIATES)/APPS/DeskClock_intermediates/package.apk

    aaptflags: [
        "-I",
        TARGET_OUT_INTERMEDIATES + "/APPS/DeskClock_intermediates/package.apk",
    ],

}
